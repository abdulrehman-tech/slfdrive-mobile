# API Configuration
API_BASE_URL=https://api.slfdrive.com/v1
WS_BASE_URL=wss://api.slfdrive.com/v1

# Payment
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Maps
GOOGLE_MAPS_API_KEY=AIza_your_key_here
# Places API (New) REST key for the location-picker search. Must have NO
# HTTP-referrer / app restriction (REST → empty referer → 403). Restrict by API
# to "Places API (New)" only. Leave blank to fall back to GOOGLE_MAPS_API_KEY.
PLACES_API_KEY=AIza_your_places_key_here

# Analytics
CLARITY_PROJECT_ID=your_clarity_project_id

# Firebase (Optional - if using Firebase Auth instead of REST)
# These will be auto-generated by flutterfire configure
